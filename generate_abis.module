<?php

/**
 * Implements hook_menu().
 */
function generate_abis_menu() {
  $items['api/generate-abis/journal-number'] = array(
    'page callback' => 'generate_abis_journal_number_callback',
    'access callback' => TRUE, // Открытый доступ
    'type' => MENU_CALLBACK,
    'delivery callback' => 'generate_abis_json_output',
  );
  $items['api/generate-abis/journalarticle/%'] = array(
    'page callback' => 'generate_abis_journalarticle_id_callback',
    'page arguments' => array(3),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'generate_abis_json_output',
  );
  $items['api/generate-abis/journal-data'] = array(
    'page callback' => 'generate_abis_journal_data_callback',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'generate_abis_json_output',
  );
  $items['api/generate-abis/journal-list/%'] = array(
    'page callback' => 'generate_abis_journal_list_callback',
    'page arguments' => array(3),
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
    'delivery callback' => 'generate_abis_json_output',
  );
  return $items;
}

/**
 * Custom JSON delivery callback with unescaped Unicode.
 */
function generate_abis_json_output($var = NULL) {
  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');
  if (isset($var)) {
    echo json_encode($var, JSON_UNESCAPED_UNICODE);
  }
}

/**
 * Returns the first scalar value of a node field.
 */
function generate_abis_get_field_value($node, $field_name, $langcode = NULL) {
  $items = field_get_items('node', $node, $field_name, $langcode);

  if (empty($items[0])) {
    return '';
  }

  $item = $items[0];
  foreach (array('safe_value', 'value', 'target_id', 'tid', 'nid') as $key) {
    if (isset($item[$key])) {
      return $item[$key];
    }
  }

  return '';
}

/**
 * Returns a normalized value for a node field.
 */
function generate_abis_get_field_values($node, $field_name, $langcode = NULL) {
  $items = field_get_items('node', $node, $field_name, $langcode);

  if (empty($items)) {
    return '';
  }

  $values = array();
  foreach ($items as $item) {
    $values[] = generate_abis_normalize_field_item($item);
  }

  return count($values) == 1 ? reset($values) : $values;
}

/**
 * Normalizes a field item for API output.
 */
function generate_abis_normalize_field_item($item) {
  if (isset($item['fid'])) {
    $file = file_load($item['fid']);

    return array(
      'fid' => (int) $item['fid'],
      'filename' => !empty($file->filename) ? $file->filename : '',
      'uri' => !empty($file->uri) ? $file->uri : '',
      'url' => !empty($file->uri) ? file_create_url($file->uri) : '',
      'description' => isset($item['description']) ? $item['description'] : '',
      'display' => isset($item['display']) ? (int) $item['display'] : 1,
    );
  }

  if (isset($item['target_id'])) {
    return $item['target_id'];
  }

  if (isset($item['tid'])) {
    return $item['tid'];
  }

  if (isset($item['nid'])) {
    return $item['nid'];
  }

  if (isset($item['safe_value']) || isset($item['value'])) {
    $value = isset($item['safe_value']) ? $item['safe_value'] : $item['value'];

    if (isset($item['summary']) || isset($item['safe_summary'])) {
      return array(
        'value' => $value,
        'summary' => isset($item['safe_summary']) ? $item['safe_summary'] : $item['summary'],
      );
    }

    return $value;
  }

  return $item;
}

/**
 * Callback функция для API.
 */
function generate_abis_journal_number_callback() {
  // Отключаем кэш страницы drupal, чтобы ответ всегда был актуальным
  drupal_page_is_cacheable(FALSE);

  $data = array();

  // 1. Делаем запрос к базе, чтобы получить ID (nid) всех нод типа journal_number
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
        ->entityCondition('bundle', 'journal_number')
        ->propertyCondition('status', NODE_PUBLISHED); // Берем только опубликованные. Если нужны все - уберите эту строку.

  $result = $query->execute();

  // 2. Если ноды найдены, загружаем их
  if (isset($result['node'])) {
    $nids = array_keys($result['node']);
    // Загружаем сразу все ноды списком (оптимизация)
    $nodes = node_load_multiple($nids);

    foreach ($nodes as $node) {
      // 3. Получаем значение поля title_field
      // Используем field_get_items для безопасного получения значения (учитывает язык и т.д.)
      $title_items = field_get_items('node', $node, 'title_field');
      
      $title_value = '';
      if ($title_items) {
        // Берем 'safe_value', чтобы текст прошел проверки безопасности, 
        // или 'value' если нужно сырое значение.
        $title_value = $title_items[0]['safe_value']; 
      }

      // Если поля title_field нет, но нужен стандартный title ноды (fallback):
      if (empty($title_value)) {
        $title_value = $node->title;
      }

      $title_en_value = generate_abis_get_field_value($node, 'title_field', 'en');

      // Формируем элемент массива
      $data[] = array(
        'id' => $node->nid,
        'title' => array(
          'ru' => $title_value,
          'en' => $title_en_value,
        ),
        'year' => substr(generate_abis_get_field_value($node, 'field_year'), 0, 4),
        'volume' => generate_abis_get_field_value($node, 'field_volume'),
        'number' => generate_abis_get_field_value($node, 'field_number'),
        'part' => generate_abis_get_field_value($node, 'field_part'),
        'journal_no_start' => generate_abis_get_field_value($node, 'field_journal_no_start'),
        'journal_no_end' => generate_abis_get_field_value($node, 'field_journal_no_end'),
      );
    }
  }

  return $data;
}

/**
 * Callback for journal data (titleid, issn).
 */
function generate_abis_journal_data_callback() {
  drupal_page_is_cacheable(FALSE);

  return array(
    'titleid' => variable_get('elibrary_titleid', ''),
    'issnPrint' => variable_get('issnPrint_citation', ''),
    'issnOnline' => variable_get('issnOnline_citation', ''),
  );
}

/**
 * Callback for journal list by journal_number id.
 */
function generate_abis_journal_list_callback($nid) {
  drupal_page_is_cacheable(FALSE);

  $nid = (int) $nid;
  if ($nid <= 0) {
    drupal_add_http_header('Status', '400 Bad Request');
    return array('error' => 'Invalid node id.');
  }

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
        ->entityCondition('bundle', 'journalarticle')
        ->propertyCondition('status', NODE_PUBLISHED)
        ->fieldCondition('field_journal_link', 'target_id', $nid, '=');

  $result = $query->execute();

  $data = array();
  if (isset($result['node'])) {
    $nids = array_keys($result['node']);
    $nodes = node_load_multiple($nids);

    foreach ($nodes as $node) {
      $title_ru = generate_abis_get_field_values($node, 'title_field', 'ru');
      $title_en = generate_abis_get_field_values($node, 'title_field', 'en');

      if (empty($title_ru)) {
        $title_ru = $node->title;
      }

      $data[] = array(
        'id' => (int) $node->nid,
        'title' => array(
          'ru' => $title_ru,
          'en' => $title_en,
        ),
        'page_no' => generate_abis_get_field_values($node, 'field_page_no'),
      );
    }
  }

  return $data;
}

/**
 * Callback for a journalarticle node by id.
 */
function generate_abis_journalarticle_id_callback($nid) {
  drupal_page_is_cacheable(FALSE);

  $nid = (int) $nid;
  if ($nid <= 0) {
    drupal_add_http_header('Status', '400 Bad Request');
    return array(
      'error' => 'Invalid node id.',
    );
  }

  $node = node_load($nid);
  if (empty($node)) {
    drupal_add_http_header('Status', '404 Not Found');
    return array(
      'error' => 'Node not found.',
    );
  }

  if ($node->type != 'journalarticle') {
    drupal_add_http_header('Status', '400 Bad Request');
    return array(
      'error' => 'Node is not journalarticle.',
    );
  }

  $heading_tid = generate_abis_get_field_values($node, 'field_heading');
  $heading_data = '';
  if (!empty($heading_tid)) {
    $heading_term = taxonomy_term_load($heading_tid);
    $heading_ru = !empty($heading_term) ? $heading_term->name : '';
    $heading_i18n = i18n_get_object('taxonomy_term', $heading_tid);
    $heading_en_term = $heading_i18n->localize('en');
    $heading_en = !empty($heading_en_term) ? $heading_en_term->name : '';
    $heading_data = array(
      'tid' => (int) $heading_tid,
      'ru' => $heading_ru,
      'en' => $heading_en,
    );
  }

  $typersci_tid = generate_abis_get_field_values($node, 'field_typersci');
  $typersci_data = '';
  if (!empty($typersci_tid)) {
    $typersci_term = taxonomy_term_load($typersci_tid);
    $typersci_ru = !empty($typersci_term) ? $typersci_term->name : '';
    $typersci_i18n = i18n_get_object('taxonomy_term', $typersci_tid);
    $typersci_en_term = $typersci_i18n->localize('en');
    $typersci_en = !empty($typersci_en_term) ? $typersci_en_term->name : '';
    $typersci_abbreviation = '';
    if (!empty($typersci_term) && isset($typersci_term->field_abbreviation['und'][0]['value'])) {
      $typersci_abbreviation = $typersci_term->field_abbreviation['und'][0]['value'];
    }
    $typersci_data = array(
      'tid' => (int) $typersci_tid,
      'ru' => $typersci_ru,
      'en' => $typersci_en,
      'abbreviation' => $typersci_abbreviation,
    );
  }

  return array(
    'id' => (int) $node->nid,
    'language' => $node->language,
    'title' => array(
      'ru' => generate_abis_get_field_values($node, 'title_field'),
      'en' => generate_abis_get_field_values($node, 'title_field', 'en'),
    ),
    'language' => generate_abis_get_field_values($node, 'field_language'),
    'heading' => $heading_data,
    'typersci' => $typersci_data,
    'udk' => generate_abis_get_field_values($node, 'field_udk'),
    'edn' => generate_abis_get_field_values($node, 'field_edn'),
    'doi' => generate_abis_get_field_values($node, 'field_doi'),
    'autor' => generate_abis_build_autor_data($node),
    'key_words' => generate_abis_build_taxonomy_data($node, 'field_key_words'),
    'acknowledgments' => generate_abis_get_field_values($node, 'field_acknowledgments'),
    'funding' => generate_abis_get_field_values($node, 'field_funding'),

    // 'date_received' => generate_abis_get_field_values($node, 'field_date_received'),
    // 'accepted' => generate_abis_get_field_values($node, 'field_accepted'),
    // 'published' => generate_abis_get_field_values($node, 'field_published'),

    'date_received' => generate_abis_format_date(generate_abis_get_field_values($node, 'field_date_received')),
    'accepted' => generate_abis_format_date(generate_abis_get_field_values($node, 'field_accepted')),
    'published' => generate_abis_format_date(generate_abis_get_field_values($node, 'field_published')),


    'page_no' => generate_abis_get_field_values($node, 'field_page_no'),
    'page_no_to' => generate_abis_get_field_values($node, 'field_page_no_to'),
    'body' => generate_abis_get_body_data($node),
    'literature' => generate_abis_build_literature($node),
    'short_text_pdf' => generate_abis_get_field_values($node, 'field_short_text_pdf'),
    'fulltext' => generate_abis_get_field_values($node, 'field_fulltext'),
    'text_pdf' => generate_abis_get_field_values($node, 'field_text_pdf'),
    'text_pdf_en' => generate_abis_get_field_values($node, 'field_text_pdf_en'),
    'journal_link' => generate_abis_get_field_values($node, 'field_journal_link'),
    'status' => generate_abis_get_field_values($node, 'field_status'),
  );
}

function generate_abis_build_autor_data($node) {
  $autor_items = field_get_items('node', $node, 'field_autor');
  if (empty($autor_items)) {
    return array();
  }

  $autors = array();
  $num = 1;
  foreach ($autor_items as $item) {
    $uid = isset($item['uid']) ? $item['uid'] : (isset($item['target_id']) ? $item['target_id'] : 0);
    if (empty($uid)) {
      continue;
    }

    $user = user_load($uid);
    if (empty($user)) {
      continue;
    }

    $surname_ru = '';
    if (isset($user->field_lastname['ru'][0]['value'])) {
      $surname_ru = $user->field_lastname['ru'][0]['value'];
    }
    $surname_en = '';
    if (isset($user->field_lastname['en'][0]['value'])) {
      $surname_en = $user->field_lastname['en'][0]['value'];
    }

    $name_ru = '';
    if (isset($user->field_name2['ru'][0]['value'])) {
      $name_ru = $user->field_name2['ru'][0]['value'];
    }
    $name_en = '';
    if (isset($user->field_name2['en'][0]['value'])) {
      $name_en = $user->field_name2['en'][0]['value'];
    }

    $middle_name_ru = '';
    if (isset($user->field_middle_name['ru'][0]['value'])) {
      $middle_name_ru = $user->field_middle_name['ru'][0]['value'];
    }
    $middle_name_en = '';
    if (isset($user->field_middle_name['en'][0]['value'])) {
      $middle_name_en = $user->field_middle_name['en'][0]['value'];
    }

    $field_researcherid = '';
    if (isset($user->field_researcherid['und'][0]['value'])) {
      $field_researcherid = $user->field_researcherid['und'][0]['value'];
    }

    $field_spin = '';
    if (isset($user->field_spin_elibrary['und'][0]['value'])) {
      $field_spin = $user->field_spin_elibrary['und'][0]['value'];
    }

    $field_scopusid = '';
    if (isset($user->field_scopusid['und'][0]['value'])) {
      $field_scopusid = $user->field_scopusid['und'][0]['value'];
    }

    $field_orcid = '';
    if (isset($user->field_orcid['und'][0]['value'])) {
      $field_orcid = $user->field_orcid['und'][0]['value'];
    }

    $company_data = '';
    $company_target_id = 0;
    if (isset($user->field_company_link['und'][0]['target_id'])) {
      $company_target_id = $user->field_company_link['und'][0]['target_id'];
      $company_node = node_load($company_target_id);
      if (!empty($company_node)) {
        $orgname_ru = '';
        if (isset($company_node->title_field['ru'][0]['value'])) {
          $orgname_ru = $company_node->title_field['ru'][0]['value'];
        }
        $orgname_en = '';
        if (isset($company_node->title_field['en'][0]['value'])) {
          $orgname_en = $company_node->title_field['en'][0]['value'];
        }
        $address_ru = '';
        if (isset($company_node->field_address['ru'][0]['value'])) {
          $address_ru = $company_node->field_address['ru'][0]['value'];
        }
        $address_en = '';
        if (isset($company_node->field_address['en'][0]['value'])) {
          $address_en = $company_node->field_address['en'][0]['value'];
        }
        $company_data = array(
          'orgName' => array(
            'ru' => $orgname_ru,
            'en' => $orgname_en,
          ),
          'address' => array(
            'ru' => $address_ru,
            'en' => $address_en,
          ),
        );
      }
    }

    $autors[] = array(
      'uid' => (int) $uid,
      'num' => str_pad($num, 3, '0', STR_PAD_LEFT),
      'surname' => array(
        'ru' => $surname_ru,
        'en' => $surname_en,
      ),
      'name' => array(
        'ru' => $name_ru,
        'en' => $name_en,
      ),
      'middle_name' => array(
        'ru' => $middle_name_ru,
        'en' => $middle_name_en,
      ),
      'initials' => array(
        'ru' => $name_ru . ' ' . $middle_name_ru,
        'en' => $name_en . ' ' . $middle_name_en,
      ),
      'company' => array(
        'target_id' => (int) $company_target_id,
        'data' => $company_data,
      ),
      'researcherid' => $field_researcherid,
      'spin' => $field_spin,
      'scopusid' => $field_scopusid,
      'orcid' => $field_orcid,
    );

    $num++;
  }

  return $autors;
}

function generate_abis_get_body_data($node) {
  $body_ru = '';
  $body_items_ru = field_get_items('node', $node, 'body', 'ru');
  if (!empty($body_items_ru[0]['value'])) {
    $body_ru = strip_tags($body_items_ru[0]['value']);
  }

  $body_en = '';
  $body_items_en = field_get_items('node', $node, 'body', 'en');
  if (!empty($body_items_en[0]['value'])) {
    $body_en = strip_tags($body_items_en[0]['value']);
  }

  return array(
    'ru' => $body_ru,
    'en' => $body_en,
  );
}

function generate_abis_build_taxonomy_data($node, $field_name) {
  $items_ru = field_get_items('node', $node, $field_name, 'ru');
  $items_en = field_get_items('node', $node, $field_name, 'en');

  $ru_page = array();
  if (!empty($items_ru)) {
    foreach ($items_ru as $item) {
      $tid = isset($item['tid']) ? $item['tid'] : (isset($item['target_id']) ? $item['target_id'] : 0);
      if (empty($tid)) {
        continue;
      }
      $term = taxonomy_term_load($tid);
      $ru = !empty($term) ? $term->name : '';
      $i18n_object = i18n_get_object('taxonomy_term', $tid);
      $en_term = $i18n_object->localize('en');
      $en = !empty($en_term) ? $en_term->name : '';
      $ru_page[] = array(
        'tid' => (int) $tid,
        'ru' => $ru,
        'en' => $en,
      );
    }
  }

  $en_page = array();
  if (!empty($items_en)) {
    foreach ($items_en as $item) {
      $tid = isset($item['tid']) ? $item['tid'] : (isset($item['target_id']) ? $item['target_id'] : 0);
      if (empty($tid)) {
        continue;
      }
      $term = taxonomy_term_load($tid);
      $ru = !empty($term) ? $term->name : '';
      $i18n_object = i18n_get_object('taxonomy_term', $tid);
      $en_term = $i18n_object->localize('en');
      $en = !empty($en_term) ? $en_term->name : '';
      $en_page[] = array(
        'tid' => (int) $tid,
        'ru' => $ru,
        'en' => $en,
      );
    }
  }

  return array(
    'ru_page' => $ru_page,
    'en_page' => $en_page,
  );
}

function generate_abis_format_date($value) {
  if (empty($value)) {
    return '';
  }
  $timestamp = strtotime($value);
  return $timestamp ? date('d.m.Y', $timestamp) : '';
}

function generate_abis_build_literature($node) {
  $items = field_get_items('node', $node, 'field_literature');
  if (empty($items[0]['value'])) {
    return NULL;
  }

  $html = $items[0]['value'];
  if (!preg_match_all('/<li>(.*?)<\/li>/siu', $html, $matches)) {
    return NULL;
  }

  $result = array();
  foreach ($matches[1] as $li) {
    $text = html_entity_decode($li, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $text = strip_tags($text);
    $text = trim($text);
    $result[] = array('text' => $text);
  }

  return $result;
}
